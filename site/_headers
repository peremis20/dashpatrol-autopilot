# Response headers for Netlify / Cloudflare Pages (other hosts: copy these values into the host's header config).
# Cache-Control is only set on /assets/* and /fonts/*, which never overlap, so no rules merge.
# HTML keeps the host default (revalidate on every request), so new deploys show up immediately.
/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://br-weathered-mouse-b5ymo8mn-contact.compute.c-7.us-east-2.aws.neon.tech; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  X-Frame-Options: DENY

/assets/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
